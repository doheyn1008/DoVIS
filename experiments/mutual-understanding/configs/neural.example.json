  "agents": [
    {"name": "A", "language": "ko", "backend": "neural", "native_checkpoint": "checkpoints/ko.pt"},
    {"name": "B", "language": "ja", "backend": "neural", "native_checkpoint": "checkpoints/ja.pt"}
  ]
}
